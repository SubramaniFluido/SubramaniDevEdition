<aura:component controller="carTypeSearch" extends="c:Basecmp" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
   <!--- This is how comment Markup file -->
    <aura:attribute name="buttonLabel" type="String" default="Search"/>
    <aura:attribute name="newLabel" type="String" default="New Button"/>
    <aura:attribute name="showNew" type="Boolean" default="true"/>
    <aura:attribute name="carTypes" type="Car_Type__c[]"/>
   
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <aura:registerEvent name="carSearchFormSubmit" type="c:CarSearchFormSubmitEvent" />
                                                         
    <lightning:layout horizontalAlign="center" >
        
        <lightning:layoutItem class ="selectt" padding="around-medium" >
   			 <lightning:select aura:id="carTypeId" name="selectItem" label="All Types" 
                               variant="label-hidden" value=""  >
        			<option value="" text="All Types"/>
                 <aura:iteration items="{!v.carTypes}" var="carType">
        			<option value="{!carType.Id}" text="{!carType.Name}"/>
    			</aura:iteration>
   			 </lightning:select>
        </lightning:layoutItem>
        
            <lightning:layoutItem class= "buttons">
                <lightning:button variant="brand" label="{!v.buttonLabel}" title="Brand action" onclick="{!c.newValueSelected}" />
                <aura:if isTrue="{!v.showNew}">
                    <lightning:button variant="neutral" label="{!v.newLabel}" title="Brand action" onclick="{!c.createRecord}" />
  				</aura:if>
        </lightning:layoutItem>
        
    </lightning:layout>
                      
</aura:component>
<aura:component controller="CovidController" implements="force:appHostable,flexipage:availableForAllPageTypes,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    <aura:attribute name="CovidList" type="List" access="public" />
    <aura:attribute name="Date" type="string" />
    <aura:attribute name="Time" type="string" />
    <aura:handler name="init" value="{!this}" action="{!c.doinit}" />
    <div class="slds-p-around_small">
        <article class="slds-card slds-box slds-theme_shade">
            <div class="slds-card__header slds-grid">
                <header class="slds-media slds-media_center slds-has-flexi-truncate">
                    <div class="slds-media__figure">
                        <span class="slds-icon_container slds-icon-standard-contact"
                              title="Covid19India">
                            <span class="slds-assistive-text" >Covid19India Tracker</span>
                        </span>
                    </div>
                    <div class="slds-media__body">
                        <h2 class="slds-card__header-title">
                            <a href="javascript:void(0);" class="slds-card__header-link slds-truncate"
                               title="Contacts (1)">
                                <span>Covid19India Tracker</span>
                                <div class="slds-text-align_right
                                            slds-text-color_success">Date-{!v.Date}</div>
                                <center class="slds-text-color_success"> <p> Last Update - {!v.Time}
                                    IST </p></center>
                            </a>
                        </h2>
                    </div>
                </header>
            </div>
            <div class="slds-card__body slds-box slds-theme_shade">
                <table class="slds-table slds-table_cell-buffer slds-no-row-hover
                              slds-table_bordered slds-table_fixed-layout slds-box slds-theme_shade" role="grid">
                    <thead>
                        <tr class="slds-line-height_reset">
                            <th class="" scope="col">
                                <div class="slds-truncate" title="Confimed">Confimed</div>
                            </th>
                            <th class="" scope="col">
                                <div class="slds-truncate" title="Active">Active</div>
                            </th>
                            <th class="" scope="col">
                                <div class="slds-truncate" title="Recovered">Recovered</div>
                            </th>
                            <th class="" scope="col">
                                <div class="slds-truncate" title="Deceased">Deceased</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <aura:iteration start="0" end="1" items="{!v.CovidList}" var="co">
                            <tr class="slds-hint-parent">
                                <th scope="row">
                                    <div class="slds-truncate" title="Confimed">
                                        <a href="javascript:void(0);" tabindex="-1">{!co.confirmed}</a>
                                    </div>
                                </th>
                                <td role="gridcell">
                                    <div class="slds-truncate" title="Active">{!co.active}</div>
                                </td>
                                <td role="gridcell">
                                    <div class="slds-truncate" title="Recovered">{!co.recovered}</div>
                                </td>
                                <td role="gridcell">
                                    <div class="slds-truncate" title="Deceased">{!co.deaths}</div>
                                </td>
                            </tr>
                        </aura:iteration>
                    </tbody>
                </table>
            </div>
            <footer class="slds-card__footer">
                <a class="slds-card__footer-action" href="javascript:void(0);">Subramani Kumarasamy
                </a>
            </footer>
        </article>
        <table class="slds-table slds-table_cell-buffer slds-table_bordered
                      slds-table_col-bordered">
            <thead>
                <tr class="slds-line-height_reset">
                    <th class="" scope="col">
                        <div class="slds-truncate" title="Stage / UT">Stage / UT</div>
                    </th>
                    <th class="" scope="col">
                        <div class="slds-truncate" title="Confirmed">Confirmed</div>
                    </th>
                    <th class="" scope="col">
                        <div class="slds-truncate" title="Active">Active</div>
                    </th>
                    <th class="" scope="col">
                        <div class="slds-truncate" title="Recovered">Recovered</div>
                    </th>
                    <th class="" scope="col">
                        <div class="slds-truncate" title="Deceased">Deceased</div>
                    </th>
                </tr>
            </thead>
            <tbody>
                <aura:iteration start="1" items="{!v.CovidList}" var="c">
                    <tr class="slds-hint-parent">
                        <th data-label="Stage / UT" scope="row">
                            <div class="slds-truncate" title="+{c.state}">
                                <a href="javascript:void(0);" tabindex="-1">{!c.state}</a>
                            </div>
                        </th>
                        <td data-label="Confirmed">
                            <div class="slds-truncate" title="+{c.confirmed}">{!c.confirmed}</div>
                        </td>
                        <td data-label="Close Date">
                            <div class="slds-truncate" title="+{c.active}">{!c.active}</div>
                        </td>
                        <td data-label="Prospecting">
                            <div class="slds-truncate" title="+{c.recovered}">{!c.recovered}</div>
                        </td>
                        <td data-label="Confidence">
                            <div class="slds-truncate" title="+{c.deaths}%">{!c.deaths}</div>
                        </td>
                    </tr>
                </aura:iteration>
            </tbody>
        </table>
    </div>
</aura:component>
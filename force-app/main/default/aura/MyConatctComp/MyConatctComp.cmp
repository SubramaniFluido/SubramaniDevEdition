<aura:component implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId" controller="MyContactsController" access="global" >
    <aura:handler name="init" action="{!c.getContactList}" value="{!this}"/>
    <aura:attribute name="contactList" type="List"/>
    <lightning:card title="Contacts">
        <p class="slds-p-horizontal_small">
            <div aura:id='recordViewForm'>
            <aura:iteration items="{!v.contactList}" var="cont">
            <lightning:recordViewForm recordId="{!cont.Id}" ObjectApiName="Contact">
              <div class="slds-box">
                   <aura:set attribute="actions">
            <lightning:button label="New" onclick="{!c.newContact}"/>
            <lightning:button label="Edit" name="edit" variant="brand" onclick="{!c.editContact}" />
            <lightning:button label="Delete" name="delete" variant="destructive" onclick="{!c.deleteContact}" />
        </aura:set>
            <lightning:input type="checkbox" value="{!cont.Id}" label="Mark for Deletion" aura:id="deleteContact" />
                    <br />
                <lightning:outputField fieldName='FirstName'/>
				<lightning:outputField fieldName='LastName'/>
				<lightning:outputField fieldName='Email'/>
                 <lightning:outputField fieldName='Phone'/> 
                    </div>
            </lightning:recordViewForm>
                 <br/>
            </aura:iteration>
           </div>
       <!---Line Break between two records-->     
            <div aura:id='recordEditForm' class='formHide'> 
            <aura:iteration items="{!v.contactList}" var="cont">
              <div class="slds-box">
                <lightning:input value="{!cont.FirstName}" />
				<lightning:input value="{!cont.LastName}"/>
				<lightning:input value="{!cont.Email}"/>
                <lightning:input value="{!cont.Phone}"/>
                 </div>
                 <br/>
            </aura:iteration>
            </div>
        </p>
        <!-- Button-->  
        <aura:set attribute="actions">
            <lightning:button label="New" onclick="{!c.newContact}"/>
            <lightning:button label="Edit" name="edit" variant="brand" onclick="{!c.editContact}" />
            <lightning:button label="Delete" name="delete" variant="destructive" onclick="{!c.deleteContact}" />
        </aura:set>
    </lightning:card>
</aura:component>
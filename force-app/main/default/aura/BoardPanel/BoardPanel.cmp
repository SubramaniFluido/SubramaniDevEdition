<aura:component implements="flexipage:availableForAllPageTypes">  
<aura:attribute name="modes" type="List" default="[
{'label': 'Easy', 'value': 'easy'},
{'label': 'Medium', 'value': 'medium'},
{'label': 'Hard', 'value': 'hard'},
]"/>
<aura:attribute name="selectedMode" type="String" access="public"/>
<aura:attribute name="disableButton" type="Boolean" default="true"/>
<aura:handler event="c:ResultApplicationEvent" action="{!c.handleApplicationEvent}"/>

<lightning:card title="Word Shuffle">
    <lightning:layout horizontalAlign="center" multipleRows="true">
        <lightning:layoutItem padding="around-small">
            <lightning:combobox aura:id="gameMode" variant="label-hidden" name="progress" label="Game Mode" value="Select Game Mode" placeholder="Select Game Mode" options="{!v.modes}" />
        </lightning:layoutItem>
        <lightning:layoutItem padding="around-small">
            <lightning:button variant="brand" label="Start New Game" title="Start New Game" onclick="{! c.startGame }" />
        </lightning:layoutItem>
        <lightning:layoutItem padding="around-small">
            <lightning:button label="Reshuffle" title="Reshuffle" disabled="{!v.disableButton}" onclick="{! c.resuffleGame }"/>  
        </lightning:layoutItem>
        <lightning:layoutItem size="12" padding="around-small">
            <aura:if isTrue="{! (v.selectedMode!= null)}">
                <c:Board aura:id="childComponent" gameMode= "{!v.selectedMode}"/>
                <aura:set attribute="else">
                Please select the Game mode to Show the Game Board
                </aura:set>
            </aura:if>
        </lightning:layoutItem>
    </lightning:layout>
</lightning:card>

</aura:component>